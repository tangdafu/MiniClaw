# OpenAI 兼容 API 配置
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Token 预算上下文压缩配置；低于触发线时发送完整历史，超过后写入 model_context.json 摘要缓存
MINICLAW_CONTEXT_COMPACT_TRIGGER_TOKENS=180000
MINICLAW_CONTEXT_COMPACT_TARGET_TOKENS=90000
MINICLAW_CONTEXT_SUMMARY_TARGET_TOKENS=8000
MINICLAW_CONTEXT_COMPRESSION_MODEL=

# 工具结果剪枝配置；只影响模型请求上下文，chat.json 仍保存完整工具结果
MINICLAW_TOOL_RESULT_PRUNE_TRIGGER_TOKENS=12000
MINICLAW_TOOL_RESULT_PRUNE_KEEP_TOKENS=2000
MINICLAW_TOOL_RESULT_PRUNE_TOTAL_RATIO=0.30
MINICLAW_TOOL_RESULT_PRUNE_TARGET_RATIO=0.20
MINICLAW_PRUNED_TOOL_RESULT_READ_MAX_CHARS=20000

# 默认 system prompt 配置
# Agent 名称会作为身份提示注入默认提示词，不会要求模型反复自我介绍
MINICLAW_AGENT_NAME=汤xio夫

# 追加到默认 system prompt 尾部的本地自定义指令，可留空
MINICLAW_SYSTEM_PROMPT_EXTRA=

# 设为 true/1/yes/on 时，不注入默认 system prompt
MINICLAW_DISABLE_DEFAULT_SYSTEM_PROMPT=false

# 长期记忆配置
# 记忆正文以 Markdown 存储，SQLite 存储索引、FTS 和向量 blob
MINICLAW_MEMORY_DIR=memories

# 可选 Embeddings 配置；未配置时 remember 和 fts 搜索仍可用，vector 搜索不可用，hybrid 降级为 fts
MINICLAW_EMBEDDING_MODEL=
MINICLAW_EMBEDDING_BASE_URL=
MINICLAW_EMBEDDING_API_KEY=
